# Set strong, unique values before using authentication endpoints.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Comma-separated browser origins allowed to access the backend.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Required by upload features.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
